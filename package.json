{
  "name": "geom-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "幾何構造ベースのウェブスクレイパー — CSSクラス/XPath不使用でカードを抽出",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "scrape": "tsx src/index.ts",
